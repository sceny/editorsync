{
  "name": "sceny-editor-sync",
  "displayName": "Sceny Editor Sync",
  "icon": "icon.png",
  "description": "Synchronize AI editor rules between Cursor, VS Code, and Antigravity",
  "version": "0.1.4",
  "publisher": "sceny",
  "author": {
    "name": "Sceny"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.cursorrules",
    "workspaceContains:.cursor/rules",
    "workspaceContains:.cursor/commands",
    "workspaceContains:.agent/rules",
    "workspaceContains:.agent/workflows"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scenyEditorSync.syncAll",
        "title": "Sync All",
        "category": "Sceny Editor Sync"
      },
      {
        "command": "scenyEditorSync.forceSyncAll",
        "title": "Force Sync All",
        "category": "Sceny Editor Sync"
      },
      {
        "command": "scenyEditorSync.syncFromCursor",
        "title": "Sync From Cursor",
        "category": "Sceny Editor Sync"
      },
      {
        "command": "scenyEditorSync.syncFromAntigravity",
        "title": "Sync From Antigravity",
        "category": "Sceny Editor Sync"
      },
      {
        "command": "scenyEditorSync.syncFromVSCode",
        "title": "Sync From VS Code",
        "category": "Sceny Editor Sync"
      },
      {
        "command": "scenyEditorSync.syncFolder",
        "title": "Sync From Here",
        "category": "Sceny Editor Sync"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "scenyEditorSync.syncFolder",
          "when": "explorerResourceIsFolder && resourcePath =~ /\\.cursor[\\\\\\/](rules|commands)/ || resourcePath =~ /\\.agent[\\\\\\/](rules|workflows)/ || resourcePath =~ /\\.github/",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "scenyEditorSync.syncAll",
          "when": "true"
        },
        {
          "command": "scenyEditorSync.forceSyncAll",
          "when": "true"
        },
        {
          "command": "scenyEditorSync.syncFromCursor",
          "when": "true"
        },
        {
          "command": "scenyEditorSync.syncFromAntigravity",
          "when": "true"
        },
        {
          "command": "scenyEditorSync.syncFromVSCode",
          "when": "true"
        }
      ]
    },
    "configuration": [
      {
        "title": "Sceny Editor Sync",
        "properties": {
          "scenyEditorSync.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable synchronization of AI assistant configuration files"
          },
          "scenyEditorSync.deletionBehavior": {
            "type": "string",
            "default": "ask",
            "enum": [
              "ignore",
              "delete",
              "ask"
            ],
            "enumDescriptions": [
              "Do nothing when source file is deleted",
              "Delete the destination file when source is deleted",
              "Ask the user what to do when source file is deleted"
            ],
            "description": "Behavior when a source file is deleted"
          },
          "scenyEditorSync.limitBehavior": {
            "type": "string",
            "default": "warn",
            "enum": [
              "warn",
              "silent"
            ],
            "enumDescriptions": [
              "Show a warning when content exceeds Antigravity's 12k character limit",
              "Sync silently without warnings"
            ],
            "description": "Behavior when content exceeds platform limits"
          },
          "scenyEditorSync.syncPlatforms": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "enum": [
                "cursor",
                "antigravity",
                "vscode"
              ]
            },
            "description": "Platforms to sync to. Empty = auto-detect from available folders."
          }
        }
      },
      {
        "title": "Sceny Editor Sync › Logging",
        "properties": {
          "scenyEditorSync.logLevel": {
            "type": "string",
            "default": "info",
            "enum": [
              "error",
              "warn",
              "info",
              "debug"
            ],
            "enumDescriptions": [
              "Only log errors",
              "Log warnings and errors",
              "Log info, warnings, and errors",
              "Log everything including debug info"
            ],
            "description": "Log level for .rulessync/logs/"
          },
          "scenyEditorSync.logRetentionDays": {
            "type": "number",
            "default": 7,
            "minimum": 1,
            "maximum": 90,
            "description": "Number of days to keep log files before auto-cleanup"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
